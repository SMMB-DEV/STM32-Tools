	"version": "0.2.0",
	"configurations": [
		{
			"name": "Args",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"args": "${command:pickArgs}",
			"cwd": "${workspaceFolder}/../../MDK-ARM"
		},
		{
			"name": "Normal",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"args": "--offset 0x08020000 --max-size 0xE0000 --encrypt --key \"ABCD\"",
			"cwd": "${workspaceFolder}/../../MDK-ARM"
		}
	]
}